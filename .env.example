# ============================================================================
#  Afirmative Pill — variables de entorno
#  Copiar a .env.local (nunca commitear) o cargar con `vercel env pull .env.local`.
# ============================================================================

# Pooler de Supabase en modo TRANSACCIÓN (puerto 6543).
# Es la que usa el servidor GraphQL en cada request. Obligatoria en serverless: cada
# invocación abre y cierra conexiones y sin pooler se agota el cupo del proyecto.
# Supabase ▸ botón Connect ▸ pestaña "Transaction pooler".
# Si la contraseña tiene @ : / ? # [ ] o %, hay que codificarla en porcentaje (@ -> %40).
DATABASE_URL="postgresql://postgres.wcmiyijouostqxrusqrd:CONTRASEÑA@aws-0-us-west-2.pooler.supabase.com:6543/postgres"

# Conexión directa / sesión (puerto 5432).
# Dos usos: las migraciones (`npm run db:setup`) y la conexión que hace LISTEN para las
# GraphQL Subscriptions — LISTEN necesita una sesión persistente que el pooler en modo
# transacción no puede sostener.
DIRECT_URL="postgresql://postgres.wcmiyijouostqxrusqrd:CONTRASEÑA@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Demora artificial del projector, en milisegundos.
# Hace VISIBLE la consistencia eventual durante la sustentación: es el tiempo que la UI
# muestra el estado "Validando tu orden…" antes de que la proyección alcance al comando.
# En producción real iría en 0.
PROJECTION_DELAY_MS=1200

# Conexiones máximas por instancia de la función. Bajo a propósito: Fluid Compute puede
# levantar varias instancias y todas comparten el cupo del proyecto de Supabase.
PG_POOL_MAX=3

# debug muestra cada consulta SQL en consola (útil para demostrar el DataLoader).
LOG_LEVEL=debug
