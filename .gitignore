# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Windows / OneDrive
Thumbs.db
Desktop.ini
~$*

# editores
.vscode/
.idea/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero .env.example SÍ se versiona: documenta qué variables necesita el proyecto.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SDL ensamblado por `npm run schema` (se regenera en cada build)
src/server/schema/typeDefs.generated.ts

# Agent Skills instaladas con `npx skills add` (herramientas del entorno de desarrollo,
# no del proyecto). Se reinstalan con skills-lock.json, que sí se versiona.
/.agents/skills/
/.claude/skills/
# Permisos locales de Claude Code (propios de cada máquina)
/.claude/settings.local.json
